+// valueType matches decode: with attached rights, h decodes to UnixFD,
+// including values nested in arrays and dictionary keys or values.
+func (dec *decoder) valueType(sig string) reflect.Type {
+	if len(dec.fds) == 0 {
+		return typeFor(sig)
+	}
+	switch sig[0] {
+	case 'h':
+		return unixFDType
+	case 'a':
+		if sig[1] == '{' {
+			return reflect.MapOf(dec.valueType(sig[2:3]), dec.valueType(sig[3:len(sig)-1]))
+		}
+		return reflect.SliceOf(dec.valueType(sig[1:]))
+	default:
+		return typeFor(sig)
 	}
 }
 
