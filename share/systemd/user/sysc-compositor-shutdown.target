# Started by sysc-compositor-session after the compositor exits, crashed or
# not, as niri-shutdown.target is: it stops the graphical session.
[Unit]
Description=Shutdown running sysc-compositor session
DefaultDependencies=no
StopWhenUnneeded=true

Conflicts=graphical-session.target graphical-session-pre.target
After=graphical-session.target graphical-session-pre.target
