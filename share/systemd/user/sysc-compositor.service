# Run by sysc-compositor-session, as niri.service is by niri-session. Binding
# graphical-session.target starts it once the compositor is ready, which
# systemd refuses to do by hand, and stops it when the compositor exits.
[Unit]
Description=sysc-compositor, a Niri-compatible Wayland compositor
Documentation=https://github.com/Nomadcxx/sysc-compositor
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target

Wants=xdg-desktop-autostart.target
Before=xdg-desktop-autostart.target

[Service]
Slice=session.slice
Type=notify
ExecStart=/usr/local/bin/sysc-compositor --session
