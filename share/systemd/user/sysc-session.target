# Started by `sysc-compositor --session`. systemd refuses to start
# graphical-session.target by hand; binding it here brings it up. On exit the
# compositor stops graphical-session.target, and this target stops with it.
[Unit]
Description=sysc-compositor session
Documentation=https://github.com/Nomadcxx/sysc-compositor
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
